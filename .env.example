# ---------------------------------------------------------------------------
# Iksir environment
# Copy to .env and fill in. Nothing here has a value that is safe to ship.
# ---------------------------------------------------------------------------

# Runtime mode: development | production
# In production the app refuses to start if SECRET_KEY is the default, if
# CORS_ORIGINS contains "*", or if DATABASE_URL still points at SQLite.
ENVIRONMENT=development
DEBUG=false

# --- Security ---------------------------------------------------------------
# Used to sign JWTs. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anything under 32 characters is rejected in production.
SECRET_KEY=dev-insecure-secret-change-me

# Access token lifetime, in minutes. Default 1440 = 24 hours.
ACCESS_TOKEN_MINUTES=1440

# bcrypt work factor. 12 is a reasonable default on modern hardware;
# raise it if you can afford the login latency.
BCRYPT_ROUNDS=12

# --- Database ---------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./iksir.db
# Postgres (what docker-compose gives you):
# DATABASE_URL=postgresql+psycopg://iksir:iksir@db:5432/iksir

# --- CORS -------------------------------------------------------------------
# Comma-separated allow-list. Never "*" in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Rate limiting ----------------------------------------------------------
# General requests per IP per window, and the window length in seconds.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Tighter limit applied to /api/auth/* to slow credential stuffing.
AUTH_RATE_LIMIT_REQUESTS=10

# --- Screening limits -------------------------------------------------------
# Cap on compounds per request, and on SMILES length, so one request
# cannot pin the CPU.
MAX_LIBRARY_SIZE=200
MAX_SMILES_LENGTH=2000

# --- Postgres (used by docker-compose) --------------------------------------
POSTGRES_USER=iksir
POSTGRES_PASSWORD=change-this-in-production
POSTGRES_DB=iksir
